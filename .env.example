# Copy to .env and adjust. Never commit .env.

# dev | test | prod
FLASK_CONFIG=dev
SECRET_KEY=change-me-to-a-long-random-string

# Used by the postgres container in docker-compose
POSTGRES_USER=rentall
POSTGRES_PASSWORD=rentall
POSTGRES_DB=rentall

# Used when running Flask/pytest on the host (docker-compose overrides DATABASE_URL for the web container)
DATABASE_URL=postgresql://rentall:rentall@localhost:5432/rentall
TEST_DATABASE_URL=postgresql://rentall:rentall@localhost:5432/rentall_test

# Flask-Limiter storage. memory:// counts per process; use redis://... in production with several workers
RATELIMIT_STORAGE_URI=memory://
